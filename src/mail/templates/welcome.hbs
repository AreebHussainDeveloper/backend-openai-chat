<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Welcome</title>
  </head>
  <body style="margin:0; padding:0; background-color: {{theme.bodyBg}}; font-family: Arial, sans-serif;">
    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
      <tr>
        <td align="center" style="padding: 40px 0;">
          <!-- Card -->
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600"
                 style="background: {{theme.cardBg}}; border-radius:8px; overflow:hidden; box-shadow:0 2px 6px {{theme.shadow}}">
            <!-- Header / Brand Bar -->
            <tr>
              <td style="background: {{theme.brandBg}}; padding:20px; text-align:center; color: {{theme.brandText}};">
                <h1 style="margin:0; font-size:24px; font-weight:bold;">{{brandTitle}}</h1>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding:30px;">
                <h2 style="margin-top:0; color: {{theme.headingColor}};">Hi {{name}},</h2>
                <p style="color: {{theme.textColor}}; line-height:1.6; font-size:15px;">
                  Your account has been created successfully. Here are your login details:
                </p>

                <!-- Credential blocks -->
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin:20px 0; width:100%;">
                  <tr>
                    <td style="background: {{theme.boxBg}}; padding:12px 16px; border-radius:6px; border:1px solid {{theme.borderColor}}; font-size:15px; color: {{theme.textColor}};">
                      <b>Email:</b> {{email}}
                    </td>
                  </tr>
                  <tr>
                    <td style="background: {{theme.boxBg}}; padding:12px 16px; border-radius:6px; border:1px solid {{theme.borderColor}}; font-size:15px; color: {{theme.textColor}}; margin-top:10px;">
                      <b>Password:</b> {{password}}
                    </td>
                  </tr>
                </table>

                <p style="color: {{theme.textColor}}; font-size:14px; line-height:1.6;">
                  Please log in and change your password right away for security.
                </p>

                <!-- CTA -->
                <div style="text-align:center; margin:30px 0;">
                  <a href="{{loginUrl}}"
                     style="background: {{theme.buttonBg}}; color: {{theme.buttonText}}; text-decoration:none; padding:12px 24px; font-size:15px; border-radius:6px; display:inline-block;">
                    Go to Login
                  </a>
                </div>

                <p style="font-size:12px; color: {{theme.mutedColor}}; text-align:center; margin-top:40px;">
                  If you didn’t request this account, please ignore this email.
                </p>
              </td>
            </tr>
          </table>
          <!-- /Card -->
        </td>
      </tr>
    </table>
  </body>
</html>
